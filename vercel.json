{
  "buildCommand": null,
  "installCommand": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "runtime": "python3.11"
    }
  },
  "crons": [
    { "path": "/api/prf/cron/lembretes", "schedule": "0 11 * * *" },
    { "path": "/api/prf/cron/retorno", "schedule": "0 21 * * *" }
  ]
}
