{
  "buildCommand": "bash build.sh",
  "installCommand": "pip install -r requirements.txt",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/prf/cron/lembretes", "schedule": "0 11 * * *" },
    { "path": "/api/prf/cron/retorno", "schedule": "0 21 * * *" }
  ]
}
