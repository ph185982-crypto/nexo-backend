# Database
# Em produção (Supabase + Vercel) a DATABASE_URL é o pooler em transaction mode
# (porta 6543, com pgbouncer=true&connection_limit=1) e a DIRECT_URL é a conexão
# de sessão (porta 5432), usada só por migrations. No dev local as duas apontam
# para o mesmo Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/vendedoria"
DIRECT_URL="postgresql://user:password@localhost:5432/vendedoria"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# WhatsApp Business API (Meta)
META_WHATSAPP_VERIFY_TOKEN="your-verify-token"
META_WHATSAPP_ACCESS_TOKEN="your-access-token"
META_WHATSAPP_APP_SECRET="your-app-secret"

# Google OAuth (Calendar + Meet)
GOOGLE_CALENDAR_CLIENT_ID="your-google-calendar-client-id"
GOOGLE_CALENDAR_CLIENT_SECRET="your-google-calendar-client-secret"

# Sourcing de empresas (prospecção B2B) — RapidAPI é a fonte primária;
# Google Places é fallback opcional. Configure pelo menos uma.
RAPIDAPI_KEY="sua-chave-rapidapi"   # local-business-data (+ Instagram no enriquecimento)
GOOGLE_PLACES_API_KEY="AIzaSy..."

# AI (escolha um ou mais — auto-detect prioriza Anthropic → Google → OpenAI)
OPENAI_API_KEY="sk-..."          # GPT-4o + Whisper (transcrição de áudio)
ANTHROPIC_API_KEY="sk-ant-..."   # Claude Sonnet
GOOGLE_AI_API_KEY="AIzaSy..."    # Gemini 2.0 Flash

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Campaign Worker (Vercel Cron protection)
CRON_SECRET="gere-um-secret-seguro-aqui"

# API de Conversões da Meta — Business Messaging (Click-to-WhatsApp). Ver docs/meta-capi.md
# O token precisa das permissões whatsapp_business_management e whatsapp_business_manage_events.
META_CAPI_TOKEN=""                 # token de acesso (NUNCA commitar o valor real)
META_DATASET_ID=""                 # dataset da Meta que recebe os eventos
META_WABA_ID=""                    # WhatsApp Business Account ID
META_PAGE_ID=""                    # opcional — só vai no payload com META_CAPI_SEND_PAGE_ID=true
META_GRAPH_VERSION="v25.0"         # opcional
META_TEST_EVENT_CODE=""            # opcional — código do "Testar eventos" do Events Manager
META_PURCHASE_DEFAULT_VALUE="2497" # valor do Purchase quando o lead não tem valorContrato
META_CAPI_DRY_RUN=""               # "true" = só registra o payload, não envia
META_CAPI_SEND_PAGE_ID=""          # "true" = inclui page_id em user_data (documentado só p/ Messenger)
