# Banco próprio do CRM (não compartilhado com o Vendedor IA)
DATABASE_URL="postgresql://usuario:senha@host:5432/avanteza_crm"
DIRECT_URL="postgresql://usuario:senha@host:5432/avanteza_crm"

# Assinatura do cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=""

# Seed (npm run db:seed). Se SEED_ADMIN_SENHA ficar vazio, o seed gera uma senha e mostra uma vez.
SEED_ADMIN_NOME="Pedro Martins"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_SENHA=""
# true = cria algumas oportunidades fictícias para ver o kanban preenchido
SEED_DEMO="false"

# Link para abrir a conversa no Vendedor IA a partir da oportunidade (opcional)
NEXT_PUBLIC_VENDEDOR_IA_URL="https://nexo-vendedoria.vercel.app"

# Agendador (Vercel Cron) chama /api/cron/automacoes com Authorization: Bearer $CRON_SECRET. Sem isto o endpoint fica desligado.
# Gere com: openssl rand -hex 32
CRON_SECRET=""

# Agente de combinados (lê feedbacks, conversas e transcrições e sugere o que foi combinado). Sem a chave, fica
# desligado e os combinados à mão continuam funcionando. Modelo: claude-opus-5-5 (src/lib/combinados/agente.ts).
ANTHROPIC_API_KEY=""
