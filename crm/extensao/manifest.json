{
  "manifest_version": 3,
  "name": "Avanteza CRM — WhatsApp",
  "description": "Envia a conversa aberta no WhatsApp Web para a ficha do cliente no CRM Avanteza.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://nexo-crm-tawny.vercel.app/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://web.whatsapp.com/*"], "js": ["leitura.js", "content.js"], "run_at": "document_idle" }],
  "options_page": "opcoes.html",
  "action": { "default_title": "Avanteza CRM", "default_popup": "opcoes.html" },
  "icons": { "16": "icone-16.png", "48": "icone-48.png", "128": "icone-128.png" }
}
